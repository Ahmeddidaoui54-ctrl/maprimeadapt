# Supabase (free tier)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJ...

# Auth tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
OWNER_TOKEN=change_me_owner
SECOND_TOKEN=change_me_second

# APIs externes gratuites
NEWSAPI_KEY=             # https://newsapi.org (free: 100 req/jour)
EBAY_APP_ID=             # https://developer.ebay.com (free: 5000/jour)
EBAY_APP_SECRET=         # eBay OAuth secret

# Sessions Playwright (fichiers générés par: npx playwright codegen --save-storage=session.json)
LBC_SESSION_FILE=        # Chemin vers session LeBonCoin (ex: ./sessions/lbc.json)
VINTED_SESSION_FILE=     # Chemin vers session Vinted
FB_SESSION_FILE=         # Chemin vers session Facebook
EBAY_SESSION_FILE=       # Chemin vers session eBay

# Config systeme
PORT=3001
NODE_ENV=development
DRY_RUN=true
TRADER_MAX_SINGLE_OP_EUR=20
TRADER_MAX_TOTAL_EUR=50
TRADER_MAX_OPEN_OPS=3
TRADER_MAX_DELAY_HOURS=72
TRADER_STOP_LOSS_EUR=5
VEILLE_SCAN_INTERVAL_HOURS=4
MONTHLY_BUDGET_EUR=100
ALERT_THRESHOLD_EUR=80
