# ═══════════════════════════════════════════════════════
#  ArbiBot — Clés API  |  Copie ce fichier en .env
#  puis remplis tes clés (ne jamais commit .env)
# ═══════════════════════════════════════════════════════

# ════════════════════════════════════════════
#  TIER 0 — 100% GRATUIT, SANS CB, PERMANENT
# ════════════════════════════════════════════

# ── ODDS-API.IO — 100 req/heure GRATUIT À VIE
# Inscription email seul : https://odds-api.io  → clé instantanée
ODDSAPIIO_KEY=

# ── THERUNDOWN — 20 000 data points/jour GRATUIT
# Inscription : https://therundown.io/api
THERUNDOWN_KEY=

# ── API-SPORTS — free plan permanent, tous endpoints
# Inscription : https://api-sports.io  (pas de CB)
APISPORTS_KEY=

# ── SPORTBEX — accès instantané gratuit
# Inscription : https://sportbex.com
SPORTBEX_KEY=

# ── BETFAIR EXCHANGE — GRATUIT avec compte vérifié
# Inscription : https://developer.betfair.com
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=

# ════════════════════════════════════════════
#  TIER 1 — GRATUIT avec crédits de démarrage
# ════════════════════════════════════════════

# ── GEMINI API — 1 500 req/JOUR gratuit (meilleur free tier IA)
# Inscription : https://aistudio.google.com  → clé en 1 min
GEMINI_KEY=

# ── THE ODDS API — 500 req/mois gratuit
# Inscription : https://the-odds-api.com
ODDS_API_KEY=

# ── SPORTRADAR — trial gratuit
# Inscription : https://developer.sportradar.com
SPORTRADAR_KEY=

# ── PINNACLE API — gratuit avec compte
# Accès : https://pinnacleapi.github.io
PINNACLE_API_KEY=

# ── ROBOT AUTO-PLACER
DRY_RUN=true              # true = simulation sans vrais paris | false = réel
RISK_FRAC=0.005           # fraction bankroll par pari (0.005 = 0.5% = Risque 0)
MAX_STAKE=50              # plafond absolu en € par pari
PLACE_TIME_SEC=8          # temps de placement via API (plus rapide que navigateur)
WALLET_PASSWORD=          # mot de passe de déchiffrement du wallet (local uniquement)

# ── BREVO — CRM + emails leads MaPrimeAdapt (9 000 emails/mois GRATUIT)
# Inscription : https://brevo.com  → clé API dans Mon compte > SMTP & API
BREVO_API_KEY=
BREVO_LIST_ID=2               # ID de la liste contacts dans Brevo
BREVO_SENDER=noreply@maprimeadapt-idf.fr
NOTIF_EMAIL=contact@maprimeadapt-idf.fr

# ── SERVEUR LOCAL
PORT=3001
WS_PORT=3002
SCAN_INTERVAL_SEC=10
MIN_ARB_MARGIN=0.3
SCAN_TOKEN=                   # token secret pour déclencher /scan depuis l'extérieur (optionnel)
ALLOWED_ORIGINS=http://localhost,https://maprimeadapt-idf.fr,https://maprimeadapt-idf.pages.dev
