# Supabase (même projet que bot-system)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Serveur
PORT=3002

# Clé maître admin (pour créer d'autres clés API)
ADMIN_SECRET=change_me_strong_secret_32chars

# Tolérance de pointage en minutes (avant/après shift autorisé)
CLOCK_TOLERANCE_MINUTES=15

# Heures inhabituelles (en dehors de cette plage = anomalie)
UNUSUAL_HOUR_START=6
UNUSUAL_HOUR_END=22
