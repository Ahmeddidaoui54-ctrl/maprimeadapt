.section h2 { font-size: 20px; font-weight: 600; color: #1a3d2b; margin-bottom: 20px; border-bottom: 2px solid #f0f4f8; padding-bottom: 15px; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin: 20px 0; }
.card { background: #f5f9f7; border-radius: 8px; padding: 20px; border-left: 4px solid #1a3d2b; }
.card strong { color: #1a3d2b; display: block; margin-bottom: 5px; }
